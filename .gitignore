# ---------------------------------------------------------------------------
# Virtualenvs (~670 MB combined) — recreate from the versions pinned in the
# writeups (Inspect AI 0.3.251 + inspect_evals from GitHub main).
# ---------------------------------------------------------------------------
inspect-env/
.venv/
vvenv/
venv/
env/

# ---------------------------------------------------------------------------
# Eval logs (~36 MB) — two reasons, both sufficient on their own:
#   1. size: server logs are raw llama-server stdout, .eval files are binary
#      zip archives that do not delta-compress.
#   2. content: .eval files contain the models' full completions to the 313
#      StrongREJECT forbidden prompts and the 200 XSTest unsafe prompts. The
#      writeups deliberately store labels and aggregate rates only; keeping
#      that true means the raw completions stay out of the repo.
# The derived, completion-free artifacts (sr_grades/, divergence_dataset.json,
# sr_wrapped_results.json, the .md writeups) ARE tracked.
# ---------------------------------------------------------------------------
logs/

# ---------------------------------------------------------------------------
# Verbatim harmful queries — the concerning-result write-ups keep full query
# text on this machine only. The committed companion (qwen3.8-concerning-ids.md)
# carries sample IDs and categories, which rejoin to the public datasets.
# ---------------------------------------------------------------------------
*-concerning-local.md
xstest/
.q38_state/

# ---------------------------------------------------------------------------
# Local backups — kept out of the repo. divergence_dataset.backup.json is the
# pre-sanitisation copy of divergence_dataset.json and still holds the full
# harmful prompt text; it must stay local.
# ---------------------------------------------------------------------------
*.backup.json
*.backup
*.bak
*.orig

# ---------------------------------------------------------------------------
# Model weights — never commit; the GGUFs are ~16.5 GB each
# ---------------------------------------------------------------------------
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/

# ---------------------------------------------------------------------------
# Other bulky / regenerable output
# ---------------------------------------------------------------------------
*.eval
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
.cache/
.inspect/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# API keys / local env
.env

# Session history export — untracked and must never be swept in by `git add -A`
claude-history.JSON
claude-history.json

divergence2-local.md

# Real wrapper text (attack prompts) — never published
sr_wrappers.local.json
sr_compare_q38.py

# ---------------------------------------------------------------------------
# Verbatim anti-refusal / attack text embedded in third-party model artifacts.
# The qwen3.6-27b-obliteratus GGUF ships a chat template that injects a
# jailbreak-style system prompt whenever the caller sends no system message.
# The FINDING is published (hand-over2-report.log, readme.md); the TEXT is not,
# under the same rule as sr_wrappers.local.json.
# ---------------------------------------------------------------------------
*-template-local.md
*-local.md

# ---------------------------------------------------------------------------
# Phase-marker state dirs — empty files, no reader value (cf. .q38_state/)
# ---------------------------------------------------------------------------
.q38ob_state/
.ho3_state/

# ---------------------------------------------------------------------------
# Raw run logs — machine transcripts, regenerable, and server logs can echo
# prompt text. The distilled findings live in the .md/.txt write-ups.
# ---------------------------------------------------------------------------
replication.log
download.log
